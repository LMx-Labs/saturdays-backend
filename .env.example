ENVIRONMENT=development
PROJECT_NAME="Saturdays API"
API_V1_STR=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/saturdays
JWT_SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — which browser origins may call this API. Never "*" in production.
# Every browser frontend (customer web, admin, DineGuru) must match one of
# these, or its requests fail before reaching the server; DineGuru then shows
# "Cannot reach the API ... CORS_ORIGINS".
#
# Setting either variable REPLACES the default in app/core/config.py, it does
# not extend it. Leave both unset to use the defaults, or list everything.
# The effective values are logged at startup ("CORS configured").
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8443,https://saturdays.co.in,https://www.saturdays.co.in
# Vercel and Firebase Hosting (*.web.app / *.firebaseapp.com) deployments.
CORS_ORIGIN_REGEX=^https://.*(\.vercel\.app|\.web\.app|\.firebaseapp\.com|saturdays\.co\.in)$
CORS_ALLOW_CREDENTIALS=true

# Razorpay (collections + RazorpayX payouts)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
# true = orders and payouts are simulated locally (no money moves). Must be false in production.
RAZORPAY_SIMULATE=true

# Daily merchant payouts
PAYOUT_SCHEDULER_ENABLED=false
PAYOUT_SCHEDULE_HOUR_UTC=21
PAYOUT_MIN_AMOUNT=1
PAYOUT_SETTLEMENT_DELAY_HOURS=0

# Cancelled/unfulfilled orders become store credit, not cash refunds
REFUNDS_ENABLED=false
STORE_CREDIT_VALIDITY_DAYS=90
