ENVIRONMENT=development
PROJECT_NAME="Saturdays API"
API_V1_STR=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/saturdays
# Development only. Generate unique 32+ character values for production.
JWT_SECRET_KEY=change-this-development-jwt-secret
SECRET_KEY=change-this-development-app-secret
INTERNAL_CLEANUP_KEY=change-this-development-cleanup-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

PAYMENT_PROVIDER=mock
# Required when PAYMENT_PROVIDER=razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CHECKOUT_QUOTE_TTL_MINUTES=10
