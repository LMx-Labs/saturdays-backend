ENVIRONMENT=development
PROJECT_NAME="Saturdays API"
API_V1_STR=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/saturdays
# Generate a unique secret; production startup rejects the documented default.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS: comma-separated explicit origins. Never "*" in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8443
# Preview and production frontends on Vercel.
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
CORS_ALLOW_CREDENTIALS=true

# Razorpay (collections + RazorpayX payouts)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
# Production collection and payout initiation are currently blocked pending payment decisions.
RAZORPAY_SIMULATE=false

# Daily merchant payouts
PAYOUT_SCHEDULER_ENABLED=false
PAYOUT_SCHEDULE_HOUR_UTC=21
PAYOUT_MIN_AMOUNT=1
PAYOUT_SETTLEMENT_DELAY_HOURS=0

# Captured-payment cancellation is blocked pending an agreed refund policy.
REFUNDS_ENABLED=false
STORE_CREDIT_VALIDITY_DAYS=90
