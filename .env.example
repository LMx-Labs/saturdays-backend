ENVIRONMENT=development
PROJECT_NAME="Saturdays API"
API_V1_STR=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/saturdays
JWT_SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS: comma-separated explicit origins. Never "*" in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app
CORS_ALLOW_CREDENTIALS=true

# Razorpay (collections + RazorpayX payouts)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
# true = payouts are simulated locally (no money moves). Must be false in production.
RAZORPAY_SIMULATE=true

# Daily merchant payouts
PAYOUT_SCHEDULER_ENABLED=false
PAYOUT_SCHEDULE_HOUR_UTC=21
PAYOUT_MIN_AMOUNT=1
PAYOUT_SETTLEMENT_DELAY_HOURS=0

# Cancelled/unfulfilled orders become store credit, not cash refunds
REFUNDS_ENABLED=false
STORE_CREDIT_VALIDITY_DAYS=90
