# Saturdays Platform Environment Configuration

PROJECT_NAME="Saturdays Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Connection String
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/saturdays"

# Security Parameters
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# System Operational Flags
EMERGENCY_MAINTENANCE_MODE=false
MAX_CAMPUS_ORDERS_PER_HOUR=1000
